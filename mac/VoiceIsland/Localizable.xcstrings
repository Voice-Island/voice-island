      }
    },
    "Parakeet detects the language on its own; the chosen language is used by the Apple engine and by the Whisper fallback when Parakeet gets the alphabet wrong." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet devine la langue tout seul ; la langue choisie sert au moteur Apple et au repli Whisper quand Parakeet se trompe d'alphabet."
          }
        }
      }
    },
    "Parakeet understands French, English and German; it transcribes the whole sentence after the silence. Moonshine only hears English, but shows the text live." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parakeet comprend le français, l'anglais et l'allemand ; il transcrit la phrase entière après le silence. Moonshine n'entend que l'anglais, mais affiche le texte en direct."
          }
        }
      }
    },
