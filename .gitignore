# --- Personal data: never in git ------------------------------------------------------------------
# Logs: transcribed conversations, Claude Code tasks, sessions.
web/logs/
*.log
*.log.1
# User settings (Google accounts, prompt, chosen models); settings.defaults.json is regenerated.
web/settings.json
web/settings.defaults.json
# Local keys and variables (web/livekit.keys: LiveKit keys of this install, P0-4).
web/livekit.keys
.env
.env.*
!.env.example
# Personal working notes for Claude Code.
CLAUDE.md
CLAUDE.local.md
.claude/

# --- Heavy or regenerated ------------------------------------------------------------------------------
# Models (downloaded from Hugging Face, or copied by web/agent/fix_qwen_template.py).
web/models/
# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
# Web
node_modules/
.next/
web/frontend/.github/
# Mac app: the Xcode project and Info.plist are generated by xcodegen from mac/project.yml.
mac/build/
mac/build.log
mac/*.xcodeproj/
mac/VoiceIsland/Info.plist
mac/Config/Local.xcconfig
.build/
.swiftpm/
xcuserdata/
DerivedData/

# --- Experiments and references outside the published project -------------------------------------------
# Prototypes and test benches (proto/), abandoned Moshi track, copy of the LiveKit Swift SDK.
proto/
moshi-swift/
ios-ref/

# --- Generated test files ----------------------------------------------------------------------------------
# Audio clips (regenerated by web/test/make_clips.sh), screenshots, recorded answers.
web/test/*.wav
web/test/*.ogg
web/test/*.pcm
web/test/*.png
web/test/*.json
web/test/*.txt
web/test/*.log
# Voice recognition: owner's recordings (biometric data), test voices, models, results.
web/test/voice_id/data/
web/test/voice_id/results/
web/test/voice_id/.venv/

.DS_Store
web/learned.json
web/memory.json

# Session context generated by the claude-mem extension (personal)
AGENTS.md

# Conversation history (web/history/, privacy.keep_history setting): personal data.
web/history/
